{
  "services": [
    {
      "name": "ogc",
      "generator_config": {
        "wms_services": {
          "online_resources": {
            "service": "/$tenant$/ows/",
            "feature_info": "/$tenant$/api/v1/featureinfo/",
            "legend": "/$tenant$/api/v1/legend/"
          }
        }
      },
      "config": {
        "default_qgis_server_url": "http://{{QGIS_SERVER_HOST}}/ows/$tenant$/"
      }
    },
    {
      "name": "mapViewer",
      "generator_config": {
        "qwc2_config": {
          "qwc2_config_file": "{{INPUT_CONFIG_PATH}}/$tenant$/config.json",
          "qwc2_index_file": "{{INPUT_CONFIG_PATH}}/$tenant$/index.html"
        }
      },
      "config": {
        "qwc2_path": "/qwc2/$tenant$/",
        "auth_service_url": "/$tenant$/auth/",
        "data_service_url": "/$tenant$/api/v1/data/",
        "#document_service_url": "/$tenant$/api/v1/document/",
        "elevation_service_url": "/$tenant$/elevation/",
        "info_service_url": "/$tenant$/api/v1/featureinfo/",
        "legend_service_url": "/$tenant$/api/v1/legend/",
        "mapinfo_service_url": "/$tenant$/api/v1/mapinfo/",
        "ogc_service_url": "/$tenant$/ows/",
        "permalink_service_url": "/$tenant$/api/v1/permalink/",
        "print_service_url": "/$tenant$/api/v1/print/",
        "search_service_url": "/$tenant$/api/v2/search/",
        "search_data_service_url": "/$tenant$/api/v2/search/geom/"
      }
    },
    {
      "name": "featureInfo",
      "config": {
        "default_qgis_server_url": "http://{{QGIS_SERVER_HOST}}/ows/$tenant$/",
        "skip_empty_attributes": false
      },
      "resources": {
        "wms_services": []
      }
    },
    {
      "name": "print",
      "config": {
        "ogc_service_url": "http://{{QWC_OGC_HOST}}:9090/",
        "qgis_server_version": "3.16"
      }
    },
    {
      "name": "adminGui",
      "config": {
        "db_url": "postgresql:///?service=qwc_configdb",
        "config_generator_service_url": "http://{{QWC_CONFIG_HOST}}:9090",
        "totp_enabled": false,
        "user_info_fields": [],
        "proxy_url_whitelist": [],
        "proxy_timeout": 60,
        "plugins": [
          "themes",
          "config_editor"
        ],
        "input_config_path": "{{INPUT_CONFIG_PATH}}",
        "qwc2_path": "/qwc2/$tenant$",
        "#ows_service_url": "/$tenant$/ows",
        "#ogc_service_url": "/$tenant$/ows/",
        "qgs_resources_path": "/qgs-resources/$tenant$",
        "info_templates_path": "/info_templates",
        "ows_prefix": "/ows/$tenant$",
        "default_qgis_server_url": "http://{{QGIS_SERVER_HOST}}/ows/$tenant$/"
      }
    },
    {
      "name": "dbAuth",
      "config": {
        "db_url": "postgresql:///?service=qwc_configdb"
      }
    },
    {
      "name": "elevation",
      "config": {
        "elevation_dataset": "/vsicurl/https://data.sourcepole.com/srtm_1km_3857.tif"
      }
    },
    {
      "name": "permalink",
      "config": {
        "db_url": "postgresql:///?service=qwc_configdb",
        "permalinks_table": "qwc_config.permalinks",
        "user_permalink_table": "qwc_config.user_permalinks"
      }
    },
    {
      "name": "data",
      "config": {
        "geometry_default_allow_null": false
      }
    },
    {
      "name": "legend",
      "config": {
        "default_qgis_server_url": "http://{{QGIS_SERVER_HOST}}/ows/$tenant$/",
        "legend_images_path": "/legends/"
      }
    }
  ]
}