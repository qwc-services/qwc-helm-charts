{
  "$schema": "https://github.com/qwc-services/qwc-config-generator/raw/master/schemas/qwc-config-generator.json",
  "service": "config-generator",
  "config": {
    "tenant": "default",
    "default_qgis_server_url": "http://{{QGIS_SERVER_HOST}}/ows/",
    "config_db_url": "postgresql:///?service=qwc_configdb",
    "permissions_default_allow": true,
    "validate_schema": true,
    "qgis_projects_base_dir": "/data",
    "qgis_projects_scan_base_dir": "/data/scan",
    "qgis_projects_gen_base_dir": "/data/gen",
    "qwc2_base_dir": "/qwc2",
    "autogen_keyvaltable_datasets": false
  },
  "themesConfig": {
    "defaultScales": [
      100000000,
      50000000,
      25000000,
      10000000,
      4000000,
      2000000,
      1000000,
      400000,
      200000,
      80000,
      40000,
      20000,
      10000,
      8000,
      6000,
      4000,
      2000,
      1000,
      500,
      250,
      100
    ],
    "defaultPrintGrid": [
      {
        "s": 10000000,
        "x": 1000000,
        "y": 1000000
      },
      {
        "s": 1000000,
        "x": 100000,
        "y": 100000
      },
      {
        "s": 100000,
        "x": 10000,
        "y": 10000
      },
      {
        "s": 10000,
        "x": 1000,
        "y": 1000
      },
      {
        "s": 1000,
        "x": 100,
        "y": 100
      },
      {
        "s": 100,
        "x": 10,
        "y": 10
      }
    ],
    "defaultWMSVersion": "1.3.0",
    "defaultBackgroundLayers": [],
    "defaultSearchProviders": [
      "coordinates"
    ],
    "defaultMapCrs": "EPSG:3857",
    "defaultTheme": "Demo",
    "themes": {
      "items": [],
      "backgroundLayers": [
        {
          "name": "mapnik",
          "title": "Open Street Map",
          "type": "osm",
          "source": "osm",
          "attribution": "OpenStreetMap contributors",
          "attributionUrl": "https://www.openstreetmap.org/copyright",
          "thumbnail": "img/mapthumbs/mapnik.jpg"
        },
        {
          "type": "wmts",
          "url": "http://gibs.earthdata.nasa.gov/wmts/epsg3857/best/BlueMarble_ShadedRelief/default/{TileMatrixSet}/{TileMatrix}/{TileRow}/{TileCol}.jpeg",
          "title": "Blue Marble",
          "name": "bluemarble",
          "tileMatrixPrefix": "",
          "tileMatrixSet": "GoogleMapsCompatible_Level8",
          "originX": -20037508.34278925,
          "originY": 20037508.34278925,
          "projection:": "EPSG:3857",
          "resolutions": [
            156543.03390625,
            78271.516953125,
            39135.7584765625,
            19567.87923828125,
            9783.939619140625,
            4891.9698095703125,
            2445.9849047851562,
            1222.9924523925781
          ],
          "tileSize": [
            256,
            256
          ],
          "thumbnail": "img/mapthumbs/default.jpg"
        }
      ]
    }
  },
  "services": [
    {
      "name": "ogc",
      "generator_config": {
        "wms_services": {
          "online_resources": {
            "service": "/ows/",
            "feature_info": "/api/v1/featureinfo/",
            "legend": "/api/v1/legend/"
          }
        }
      },
      "config": {
        "default_qgis_server_url": "http://{{QGIS_SERVER_HOST}}/ows/"
      }
    },
    {
      "name": "mapViewer",
      "generator_config": {
        "qwc2_config": {
          "qwc2_config_file": "{{INPUT_CONFIG_PATH}}/default/config.json",
          "qwc2_index_file": "{{INPUT_CONFIG_PATH}}/default/index.html"
        }
      },
      "config": {
        "qwc2_path": "/qwc2/",
        "auth_service_url": "http://{{QWC_AUTH_HOST}}/auth/",
        "data_service_url": "http://{{QWC_DATA_HOST}}/api/v1/data/",
        "#document_service_url": "/api/v1/document/",
        "elevation_service_url": "/elevation/",
        "info_service_url": "/api/v1/featureinfo/",
        "legend_service_url": "/api/v1/legend/",
        "mapinfo_service_url": "/api/v1/mapinfo/",
        "ogc_service_url": "http://{{QWC_OGC_HOST}}/ows/",
        "permalink_service_url": "http://{{QWC_PERMALINK_HOST}}/api/v1/permalink/",
        "#print_service_url": "/api/v1/print/",
        "search_service_url": "/api/v2/search/",
        "search_data_service_url": "/api/v2/search/geom/"
      }
    },
    {
      "name": "featureInfo",
      "config": {
        "default_qgis_server_url": "http://{{QGIS_SERVER_HOST}}/ows/",
        "skip_empty_attributes": false
      },
      "resources": {
        "wms_services": [
          {
            "name": "qwc_demo",
            "root_layer": {
              "name": "qwc_demo",
              "title": "QWC Services Demo WMS",
              "layers": [
                {
                  "name": "edit_demo",
                  "title": "Edit Demo",
                  "layers": [
                    {
                      "name": "edit_points",
                      "title": "Edit Points",
                      "attributes": [
                        {
                          "name": "id"
                        },
                        {
                          "name": "name"
                        },
                        {
                          "name": "description"
                        },
                        {
                          "name": "num"
                        },
                        {
                          "name": "value"
                        },
                        {
                          "name": "type"
                        },
                        {
                          "name": "amount"
                        },
                        {
                          "name": "validated",
                          "format": "{\"t\": \"Yes\", \"f\": \"No\"}"
                        },
                        {
                          "name": "datetime"
                        },
                        {
                          "name": "geometry"
                        },
                        {
                          "name": "maptip"
                        }
                      ],
                      "display_field": "name"
                    }
                  ]
                },
                {
                  "name": "countries",
                  "title": "Countries",
                  "attributes": [
                    {
                      "name": "name",
                      "alias": "Name"
                    },
                    {
                      "name": "formal_en",
                      "alias": "Formal name"
                    },
                    {
                      "name": "pop_est",
                      "alias": "Population"
                    },
                    {
                      "name": "subregion",
                      "alias": "Subregion"
                    },
                    {
                      "name": "geometry"
                    }
                  ],
                  "display_field": "name",
                  "info_template": {
                    "type": "wms",
                    "wms_url": "http://{{QGIS_SERVER_HOST}}/ows/qwc_demo",
                    "template": "<div><h2>Demo Template</h2>Pos: {{ x }}, {{ y }}<br>Name: {{ feature.Name }}</div>"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    {
      "name": "print",
      "config": {
        "ogc_service_url": "http://{{QWC_OGC_HOST}}/ows/",
        "qgis_server_version": "3.16"
      }
    },
    {
      "name": "search",
      "config": {
        "solr_service_url": "http://qwc-solr:8983/solr/gdi/select",
        "search_result_limit": 50,
        "db_url": "postgresql:///?service=qwc_geodb"
      },
      "resources": {
        "facets": [
          {
            "name": "background",
            "filter_word": "Background"
          },
          {
            "name": "foreground",
            "filter_word": "Map"
          },
          {
            "name": "ne_10m_admin_0_countries",
            "filter_word": "Country",
            "table_name": "qwc_geodb.ne_10m_admin_0_countries",
            "geometry_column": "wkb_geometry",
            "search_id_col": "ogc_fid"
          }
        ]
      },
      "permissions": [
        {
          "role": "public",
          "permissions": {
            "dataproducts": [
              "qwc_demo"
            ],
            "solr_facets": [
              "foreground",
              "ne_10m_admin_0_countries"
            ]
          }
        }
      ]
    },
    {
      "name": "adminGui",
      "config": {
        "db_url": "postgresql:///?service=qwc_configdb",
        "config_generator_service_url": "http://{{QWC_CONFIG_HOST}}/",
        "totp_enabled": false,
        "user_info_fields": [],
        "proxy_url_whitelist": [],
        "proxy_timeout": 60,
        "plugins": [
          "themes",
          "config_editor"
        ],
        "input_config_path": "{{INPUT_CONFIG_PATH}}",
        "qwc2_path": "/qwc2",
        "qgs_resources_path": "/qgs-resources",
        "ogc_service_url": "http://{{QGIS_SERVER_HOST}}/ows/",
        "info_templates_path": "/info_templates",
        "ows_prefix": "/ows",
        "default_qgis_server_url": "http://{{QGIS_SERVER_HOST}}/ows/"
      }
    },
    {
      "name": "dbAuth",
      "config": {
        "db_url": "postgresql:///?service=qwc_configdb"
      }
    },
    {
      "name": "elevation",
      "config": {
        "elevation_dataset": "/vsicurl/https://data.sourcepole.com/srtm_1km_3857.tif"
      }
    },
    {
      "name": "mapinfo",
      "config": {
        "db_url": "postgresql:///?service=qwc_geodb",
        "info_table": "qwc_geodb.ne_10m_admin_0_countries",
        "info_geom_col": "wkb_geometry",
        "info_display_col": "name",
        "info_title": "Country"
      }
    },
    {
      "name": "permalink",
      "config": {
        "db_url": "postgresql:///?service=qwc_configdb",
        "permalinks_table": "qwc_config.permalinks",
        "user_permalink_table": "qwc_config.user_permalinks"
      }
    },
    {
      "name": "data",
      "config": {
        "geometry_default_allow_null": false
      }
    },
    {
      "name": "legend",
      "config": {
        "default_qgis_server_url": "http://{{QGIS_SERVER_HOST}}/ows/",
        "legend_images_path": "/legends/"
      }
    }
  ]
}