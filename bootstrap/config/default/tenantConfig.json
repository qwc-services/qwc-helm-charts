{
  "$schema": "https://github.com/qwc-services/qwc-config-generator/raw/master/schemas/qwc-config-generator.json",
  "service": "config-generator",
  "config": {
    "tenant": "default",
    "default_qgis_server_url": "http://{{QGIS_SERVER_HOST}}/ows/",
    "config_db_url": "postgresql:///?service=qwc_configdb",
    "permissions_default_allow": true,
    "validate_schema": true,
    "qgis_projects_base_dir": "/data",
    "qgis_projects_scan_base_dir": "/data/scan",
    "qgis_projects_gen_base_dir": "/data/gen",
    "qwc2_base_dir": "/qwc2",
    "autogen_keyvaltable_datasets": false
  },
  "themesConfig": "themes/config.json",
  "services": [
    {
      "name": "ogc",
      "generator_config": {
        "wms_services": {
          "online_resources": {
            "service": "/ows/",
            "feature_info": "/api/v1/featureinfo/",
            "legend": "/api/v1/legend/"
          }
        }
      },
      "config": {
        "default_qgis_server_url": "http://{{QGIS_SERVER_HOST}}/ows/"
      }
    },
    {
      "name": "mapViewer",
      "generator_config": {
        "qwc2_config": {
          "qwc2_config_file": "{{INPUT_CONFIG_PATH}}/default/config.json",
          "qwc2_index_file": "{{INPUT_CONFIG_PATH}}/default/index.html"
        }
      },
      "config": {
        "qwc2_path": "/qwc2/",
        "auth_service_url": "/auth/",
        "data_service_url": "/api/v1/data/",
        "ogc_service_url": "/ows/",
        "permalink_service_url": "/api/v1/permalink/"
      }
    },
    {
      "name": "adminGui",
      "config": {
        "db_url": "postgresql:///?service=qwc_configdb",
        "config_generator_service_url": "http://{{QWC_CONFIG_HOST}}/",
        "totp_enabled": false,
        "user_info_fields": [],
        "proxy_url_whitelist": [],
        "proxy_timeout": 60,
        "plugins": [
          "themes",
          "config_editor"
        ],
        "input_config_path": "{{INPUT_CONFIG_PATH}}",
        "qwc2_path": "/qwc2",
        "qgs_resources_path": "/qgs-resources",
        "ogc_service_url": "http://{{QGIS_SERVER_HOST}}/ows/",
        "info_templates_path": "/info_templates",
        "ows_prefix": "/ows",
        "default_qgis_server_url": "http://{{QGIS_SERVER_HOST}}/ows/"
      }
    },
    {
      "name": "dbAuth",
      "config": {
        "db_url": "postgresql:///?service=qwc_configdb"
      }
    },
    {
      "name": "permalink",
      "config": {
        "db_url": "postgresql:///?service=qwc_configdb",
        "permalinks_table": "qwc_config.permalinks",
        "user_permalink_table": "qwc_config.user_permalinks"
      }
    },
    {
      "name": "data",
      "config": {
        "geometry_default_allow_null": false
      }
    }
  ]
}
